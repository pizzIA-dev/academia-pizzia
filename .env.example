SECRET_KEY=your-secret-key-here
DEBUG=True
DATABASE_URL=sqlite:///db.sqlite3

# Cloudinary (documentos, PDFs, PPTs)
# Obtenlo desde: https://console.cloudinary.com/settings/api-keys
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Backblaze B2 (videos de clase - opcional, $0.006/GB/mes, 10GB gratis)
# Activa esto SOLO si quieres subir videos directamente a B2
B2_ENABLED=False
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=academia-videos
B2_REGION=us-west-004

ALLOWED_HOSTS=localhost,127.0.0.1
